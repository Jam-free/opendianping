{
  "compilerOptions": {
    "strict": false,
    "target": "ES2017",
    "module": "CommonJS",
    "lib": ["ES2017", "DOM"],
    "typeRoots": ["./typings"],
    "rootDir": ".",
    "outDir": ".",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "noEmitOnError": false
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
