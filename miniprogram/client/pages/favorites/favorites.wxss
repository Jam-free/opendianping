.page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
}

.shop-card {
  background: var(--card);
  border-radius: 0;
  padding: 28rpx;
  margin-bottom: 0;
  border: 1rpx solid var(--line);
  border-bottom: none;
}

.shop-card:last-child {
  border-bottom: 1rpx solid var(--line);
}

.card-top {
  display: flex;
  gap: 16rpx;
}

.card-main {
  flex: 1;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
}

.meta {
  margin-top: 6rpx;
  color: var(--ink);
  font-weight: 600;
}

.source-tag {
  font-size: 20rpx;
  color: var(--sub);
  background: transparent;
  padding: 4rpx 12rpx;
  border-radius: 0;
  border: 1rpx solid var(--line);
  height: fit-content;
}

.sub {
  margin-top: 12rpx;
  color: var(--sub);
  font-size: 24rpx;
}

.addr {
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ops {
  margin-top: 20rpx;
  display: flex;
  gap: 28rpx;
}

.link {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  text-decoration: underline;
}

.link.danger {
  color: var(--danger);
}
