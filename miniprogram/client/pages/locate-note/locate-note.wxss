.page {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.block {
  padding: 36rpx 28rpx;
}

.h1 {
  font-size: 36rpx;
  font-weight: 700;
}

.tip {
  margin: 8rpx 0 28rpx;
  line-height: 1.5;
}

.loc-card {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.loc-label {
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.addr-main {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.coords {
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  margin-bottom: 16rpx;
}

.mini {
  margin: 0;
  min-height: 56rpx !important;
  font-size: 24rpx !important;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: var(--sub);
  margin-bottom: 12rpx;
}

.input,
.textarea {
  width: 100%;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 加高输入区，减轻键盘/安全区遮挡 */
.input-lg {
  min-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 26rpx 24rpx;
}

.textarea {
  min-height: 160rpx;
  line-height: 1.5;
  padding-bottom: 28rpx;
}

.poi-list {
  max-height: 360rpx;
  background: var(--bg);
  border-radius: 12rpx;
}

.poi-item {
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.poi-item:last-child {
  border-bottom: none;
}

.poi-item.on {
  background: rgba(255, 107, 74, 0.08);
}

.poi-title {
  font-size: 28rpx;
  font-weight: 600;
}

.poi-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.tip-inline {
  margin: -8rpx 0 24rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.photos {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.photo,
.add-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: var(--bg);
}

.add-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #bbb;
  border: 1rpx dashed #ccc;
}

.remove {
  font-size: 24rpx;
}
