/* 主页：白底；顶栏固定位大标题；底栏独立悬浮 */

.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  /* 不要 overflow:hidden —— 微信会裁掉同树里的 fixed 底栏 */
  overflow: visible;
  background: #ffffff;
}

.header {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 40rpx 20rpx;
  gap: 24rpx;
}

.titles {
  display: flex;
  align-items: baseline;
  min-width: 0;
  flex: 1;
}

.title-hit {
  padding: 10rpx 4rpx;
  flex: none;
}

.title-hit--gap {
  margin-left: 28rpx;
  padding: 18rpx 12rpx 10rpx;
}

.title {
  line-height: 1.15;
  letter-spacing: 0.5rpx;
}

.title--on {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--primary);
}

.title--off {
  font-size: 28rpx;
  font-weight: 400;
  color: #b0b0b0;
}

.avatar-entry {
  flex: none;
  margin-right: 8rpx;
}

.avatar-hover {
  opacity: 0.72;
}

.me-av {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--placeholder);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.me-av.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #666;
}

.header-line {
  flex: none;
  height: 1rpx;
  margin: 0 40rpx;
  background: #f0f0f0;
}

.panels {
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
}

.panel-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 0 40rpx;
}

.scroll-pad {
  height: calc(220rpx + env(safe-area-inset-bottom));
}

.sheet {
  padding-top: 8rpx;
}

.list-tip {
  padding: 16rpx 0 4rpx;
  font-size: 22rpx;
  color: #c0c0c0;
}

.sheet-item {
  border-bottom: 1rpx solid #f3f3f3;
}

.sheet-item:last-child {
  border-bottom: none;
}

.rank-hint {
  padding: 24rpx 0 8rpx;
  font-size: 24rpx;
  color: #b0b0b0;
  letter-spacing: 0.5rpx;
}

.friend-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  gap: 18rpx;
  border-bottom: 1rpx solid #f3f3f3;
}

.friend-row:last-child {
  border-bottom: none;
}

.friend-row--press {
  opacity: 0.7;
}

.rank {
  width: 40rpx;
  flex: none;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #c4c4c4;
  font-variant-numeric: tabular-nums;
}

.rank--top {
  color: var(--primary);
  font-weight: 700;
}

.fav {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--placeholder);
  flex: none;
}

.fav.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 28rpx;
  color: #666;
}

.finfo {
  flex: 1;
  min-width: 0;
}

.fname {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fmeta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

.fchev {
  font-size: 34rpx;
  color: #d0d0d0;
  flex: none;
  padding-left: 8rpx;
}

.login-tip {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: #fff7f3;
  border: 1rpx solid #ffe4d9;
}

.login-tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.45;
}

.login-tip-link {
  flex: none;
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
}

.empty {
  min-height: 58vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx 80rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9a9a9a;
  line-height: 1.65;
  max-width: 480rpx;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 100% !important;
  max-width: 520rpx;
}

.empty-btn-ghost {
  width: 100% !important;
  max-width: 520rpx;
  margin-top: 20rpx;
}

/* —— 悬浮胶囊底栏（与 page 同级） —— */
.dock-safe {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  padding: 0 40rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
}

.dock {
  pointer-events: auto;
  display: flex;
  align-items: stretch;
  height: 120rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow:
    0 10rpx 40rpx rgba(0, 0, 0, 0.1),
    0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.dock-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 999rpx;
}

.dock-item--press {
  background: rgba(255, 107, 74, 0.06);
}

.dock-icon {
  width: 44rpx;
  height: 44rpx;
}

.dock-icon--ai {
  width: 48rpx;
  height: 48rpx;
}

.dock-label {
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--primary);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
