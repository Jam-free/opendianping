<view class="page">
  <block wx:if="{{step === 'guide' || step === 'input'}}">
    <view class="card block">
      <view class="h1">导入大众点评收藏</view>
      <view class="muted intro">把公开专辑或店铺链接粘贴过来，选中后加入「我的店」，默认与美食好友共享。</view>

      <view class="steps">
        <view class="s">1. 打开大众点评 → 我的 → 收藏</view>
        <view class="s">2. 打开专辑 → 分享 → 复制链接</view>
        <view class="s">3. 粘贴到下方，点「开始导入」</view>
      </view>

      <textarea
        class="input"
        placeholder="粘贴专辑或店铺链接，例如 https://h5.dianping.com/..."
        value="{{text}}"
        bindinput="onText"
        maxlength="2000"
        auto-height
      />

      <button class="btn-primary btn-block" loading="{{loading}}" bindtap="onParse">
        开始导入
      </button>
    </view>
  </block>

  <block wx:if="{{step === 'preview'}}">
    <view class="card block">
      <view class="toolbar">
        <view class="h1">确认加入 {{selectedCount}} 家</view>
        <view class="toolbar-actions">
          <text class="link" bindtap="selectAll">全选</text>
          <text class="link" bindtap="selectNone">清空</text>
        </view>
      </view>
      <view class="muted tip" wx:if="{{message}}">{{message}}</view>

      <view
        class="shop-card {{item.checked ? 'checked' : ''}}"
        wx:for="{{shops}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="toggle"
      >
        <view class="card-top">
          <view class="check {{item.checked ? 'on' : ''}}"></view>
          <view class="card-main">
            <view class="name">{{item.name}}</view>
            <view class="meta muted" wx:if="{{item.avgPrice || item.category}}">
              <text wx:if="{{item.avgPrice}}">{{item.avgPrice}}</text>
              <text wx:if="{{item.avgPrice && item.category}}"> · </text>
              <text wx:if="{{item.category}}">{{item.category}}</text>
              <text wx:if="{{item.district}}"> · {{item.district}}</text>
            </view>
          </view>
        </view>
      </view>

      <button class="btn-primary btn-block save" loading="{{saving}}" bindtap="onSave">
        加入我的店（{{selectedCount}}）
      </button>
    </view>
  </block>

  <block wx:if="{{step === 'result'}}">
    <view class="card block result">
      <view class="h1">导入完成</view>
      <view class="result-line">成功 {{result.success}} 家</view>
      <view class="result-line muted" wx:if="{{result.duplicate}}">重复 {{result.duplicate}}</view>
      <view class="result-line danger" wx:if="{{result.failed}}">失败 {{result.failed}}</view>
      <button class="btn-primary btn-block" bindtap="goMyShops">去看看</button>
      <button class="btn-ghost btn-block" bindtap="reset">再导一批</button>
    </view>
  </block>
</view>
