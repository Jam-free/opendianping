.page-stage {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-card {
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
}

.avatar-btn {
  padding: 0;
  margin: 0 auto;
  background: transparent;
  border: none;
  line-height: 1;
  width: 144rpx;
  height: 144rpx;
  display: block;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  margin: 0 auto;
  background: var(--placeholder);
  display: block;
}

.avatar.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #555;
}

.avatar-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.nick-input {
  margin-top: 28rpx;
  width: 100%;
  box-sizing: border-box;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.tip {
  margin-top: 12rpx;
  line-height: 1.5;
}

.save-btn {
  margin-top: 32rpx;
}

.actions-card {
  padding: 36rpx 32rpx;
}

.danger-btn {
  color: var(--danger);
  border-color: #f0c8c8;
}

.foot {
  margin-top: 24rpx;
  text-align: center;
  line-height: 1.55;
}
