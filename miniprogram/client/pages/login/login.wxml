<view class="page page-stage">
  <view class="hero">
    <block wx:if="{{step === 'avatar' && !draftAvatar}}">
      <image class="mark" src="/assets/app-icon.jpg" mode="aspectFill" />
      <view class="brand">我和我爱吃的朋友们</view>
      <view class="pitch muted">
        把大众点评收藏搬进来，记美食、看自己的店，再和好友慢慢共享。
      </view>
    </block>

    <view class="guide" wx:else>
      <view class="guide-title">进入后，和朋友共享热爱的美食</view>
      <view class="muted guide-desc">先选好头像和昵称，好友才能认出你</view>
    </view>

    <button
      wx:if="{{step === 'avatar'}}"
      class="login-btn"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
      loading="{{busy}}"
    >
      {{bypass ? '进入' : '微信登录'}}
    </button>

    <view class="nick-step" wx:elif="{{step === 'nickname'}}">
      <image class="preview-av" src="{{draftAvatar}}" mode="aspectFill" />
      <!--
        type=nickname 不要绑受控 value，否则点选微信昵称经常写不进。
        输入只更新草稿；进入靠延迟兜底 / 失焦 / 下方按钮。
      -->
      <input
        class="nick-input"
        type="nickname"
        placeholder="点这里选微信昵称"
        bindinput="onNickInput"
        bindblur="onNickBlur"
        bindconfirm="onNickConfirm"
      />
      <button
        class="login-btn enter-btn"
        loading="{{busy}}"
        disabled="{{busy}}"
        bindtap="onTapEnter"
      >
        {{busy ? '正在进入…' : '进入'}}
      </button>
      <view class="muted nick-hint" wx:if="{{!busy}}">选好昵称后会自动进入，也可点上方按钮</view>
      <view class="repick muted" bindtap="backToAvatar">重选头像</view>
    </view>

    <view class="hint muted" wx:if="{{step === 'avatar'}}">
      点上方后会先选择微信头像，再填写昵称。
    </view>
    <view class="err" wx:if="{{error}}">{{error}}</view>
  </view>
</view>
