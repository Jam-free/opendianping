<view class="page">
  <view class="hero card">
    <view class="brand">美食肥猫</view>
    <view class="sub muted">邀请过的朋友会出现在这里</view>
    <!-- 有好友时顶栏邀请；空态只在下方留一个按钮，避免两个「邀请好友」 -->
    <button
      wx:if="{{friends.length}}"
      class="btn-primary btn-block invite"
      open-type="share"
    >
      邀请好友
    </button>
  </view>

  <view class="profile-tip card" wx:if="{{needProfile}}" bindtap="openProfile">
    <text>完善名片，朋友才认得出你</text>
    <text class="link">去设置</text>
  </view>

  <view class="login-tip card" wx:if="{{loginError}}" bindtap="retryLogin">
    <text>{{loginError}}</text>
    <text class="link">点此重新登录</text>
  </view>

  <view class="list-wrap card" wx:if="{{friends.length}}">
    <view class="list-hd">美食好友 · {{friends.length}}</view>
    <block wx:for="{{friends}}" wx:key="id">
      <view
        class="friend-row hairline"
        bindtap="openFriend"
        data-id="{{item.id}}"
        data-name="{{item.nickname}}"
      >
        <image wx:if="{{item.avatar}}" class="av" src="{{item.avatar}}" mode="aspectFill" />
        <view wx:else class="av text">{{item.initial}}</view>
        <view class="info">
          <view class="name">{{item.nickname || '未命名好友'}}</view>
          <view class="meta muted">共享 {{item.sharedShopCount}} 家</view>
        </view>
        <text class="chev muted">›</text>
      </view>
    </block>
  </view>

  <view class="empty card" wx:elif="{{!loading && !loginError}}">
    <view class="empty-title">还没有美食好友</view>
    <view class="muted empty-desc">
      把邀请发给微信好友。对方加入并导入收藏后，会出现在这里。微信不提供全量好友名单，只能看到通过邀请进来的人。
    </view>
    <button class="btn-primary btn-block" open-type="share">邀请好友</button>
  </view>

  <view class="mask" wx:if="{{showProfile}}" bindtap="closeProfile"></view>
  <view class="sheet card" wx:if="{{showProfile}}">
    <view class="sheet-title">完善名片</view>
    <view class="form-row">
      <text class="label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{draftAvatar}}" class="av lg" src="{{draftAvatar}}" mode="aspectFill" />
        <view wx:else class="av lg text">+</view>
      </button>
    </view>
    <view class="form-row">
      <text class="label">昵称</text>
      <input
        class="nick-input"
        type="nickname"
        placeholder="微信昵称"
        value="{{draftNickname}}"
        bindblur="onNickBlur"
        bindinput="onNickInput"
      />
    </view>
    <button class="btn-primary btn-block" loading="{{savingProfile}}" bindtap="saveProfile">
      保存
    </button>
  </view>
</view>
