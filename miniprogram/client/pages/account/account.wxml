<view class="page page-stage">
  <view class="card profile-card">
    <button
      class="avatar-btn"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
    >
      <image
        wx:if="{{avatar}}"
        class="avatar"
        src="{{avatar}}"
        mode="aspectFill"
      />
      <view wx:else class="avatar text">{{initial}}</view>
    </button>
    <view class="muted avatar-hint">点头像可更换</view>

    <input
      class="nick-input"
      type="nickname"
      placeholder="点这里改微信昵称"
      value="{{draftNickname}}"
      bindinput="onNickInput"
      bindblur="onNickBlur"
    />
    <view class="muted tip">头像与昵称会展示给美食好友</view>

    <button
      class="btn-primary btn-block save-btn"
      loading="{{saving}}"
      bindtap="saveProfile"
    >
      保存名片
    </button>
  </view>

  <view class="card actions-card">
    <button class="btn-ghost btn-block danger-btn" loading="{{busy}}" bindtap="onLogout">
      退出登录 / 撤销授权
    </button>
    <view class="muted foot">
      将清除本机登录状态。下次使用需重新登录；不影响已导入的店铺数据。
    </view>
  </view>
</view>
