<view class="page" wx:if="{{shop}}">
  <scroll-view scroll-y class="scroll" enhanced show-scrollbar="{{false}}">
    <view class="card hero">
      <image
        class="hero-img"
        src="{{displaySrc}}"
        mode="aspectFill"
        binderror="onImgError"
      />
      <view class="hero-body">
        <view class="h1">{{shop.name}}</view>
        <view class="meta muted" wx:if="{{metaLine}}">{{metaLine}}</view>
        <view class="dist muted" wx:if="{{!dist.na}}">{{dist.main}}{{dist.unit}}</view>
      </view>
    </view>

    <!-- 统一操作条：图标对齐，不东一块西一块 -->
    <view class="card action-bar">
      <view
        wx:if="{{dianpingUrl}}"
        class="action"
        bindtap="openDianping"
        hover-class="action-hover"
      >
        <image class="action-icon" src="/assets/icons/dianping.png" mode="aspectFit" />
        <text class="action-label">大众点评</text>
      </view>
      <view
        wx:if="{{canNav}}"
        class="action"
        bindtap="onNav"
        hover-class="action-hover"
      >
        <image class="action-icon" src="/assets/icons/nav.png" mode="aspectFit" />
        <text class="action-label">导航</text>
      </view>
      <view
        wx:if="{{shop.phone}}"
        class="action"
        bindtap="onCall"
        hover-class="action-hover"
      >
        <image class="action-icon" src="/assets/icons/phone.png" mode="aspectFit" />
        <text class="action-label">电话</text>
      </view>
      <view
        wx:if="{{canEditCheckin}}"
        class="action"
        bindtap="goEditCheckin"
        hover-class="action-hover"
      >
        <image class="action-icon" src="/assets/icons/edit.png" mode="aspectFit" />
        <text class="action-label">编辑</text>
      </view>
    </view>

    <view class="card block">
      <view class="kv hairline" wx:if="{{shop.avgPrice}}">
        <text class="k muted">人均</text>
        <text>{{shop.avgPrice}}</text>
      </view>
      <view class="kv hairline" wx:if="{{shop.address}}">
        <text class="k muted">地址</text>
        <text class="v">{{shop.address}}</text>
      </view>
      <view class="kv">
        <text class="k muted">来源</text>
        <text>{{sourceLabel}}</text>
      </view>
    </view>

    <view class="card block comments">
      <view class="sec">评论 {{comments.length || ''}}</view>
      <view class="muted tip" wx:if="{{!comments.length}}">还没有人说话，来说一句吧。</view>
      <block wx:for="{{comments}}" wx:key="id">
        <view class="note hairline">
          <image wx:if="{{item.avatar}}" class="av" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="av text">{{item.initial}}</view>
          <view class="note-body">
            <view class="note-name">
              {{item.nickname || '好友'}}
              <text wx:if="{{item.isMine}}" class="me muted">我</text>
            </view>
            <view class="note-text">{{item.body}}</view>
            <view class="note-time muted" wx:if="{{item.timeLabel}}">{{item.timeLabel}}</view>
          </view>
        </view>
      </block>
    </view>

    <view class="scroll-pad" />
  </scroll-view>

  <view class="dock">
    <input
      class="dock-input"
      placeholder="说一句…"
      value="{{draftComment}}"
      bindinput="onCommentInput"
      confirm-type="send"
      bindconfirm="sendComment"
      maxlength="500"
      adjust-position="{{true}}"
    />
    <button
      class="dock-send"
      size="mini"
      loading="{{sending}}"
      bindtap="sendComment"
    >
      发送
    </button>
    <view
      class="heart {{wishlist ? 'on' : ''}}"
      bindtap="toggleWishlist"
      hover-class="heart-hover"
    >
      <text class="heart-icon">{{wishlist ? '♥' : '♡'}}</text>
      <text class="heart-label">心心念念</text>
    </view>
  </view>
</view>
