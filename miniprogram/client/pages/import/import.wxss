.page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 完成态：垂直居中一张结果卡，消除「贴左上 + 大片空白」 */
.page-stage {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
  padding-top: 0;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.block {
  padding: 36rpx 28rpx;
}

.stack-card .h1 {
  text-align: left;
}

.h1 {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.intro {
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.steps {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.s {
  font-size: 26rpx;
  color: #444;
  line-height: 1.7;
}

.input {
  width: 100%;
  min-height: 160rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.toolbar-actions {
  display: flex;
  gap: 24rpx;
}

.link {
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
}

.tip {
  margin-bottom: 16rpx;
}

.shop-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.shop-card.checked .check.on {
  background: var(--primary);
  border-color: var(--primary);
}

.card-top {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-top: 38rpx;
  flex: none;
  box-sizing: border-box;
}

.check.on {
  box-shadow: inset 0 0 0 6rpx #fff;
}

.preview-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex: none;
  background: var(--placeholder);
  border: 1rpx solid var(--line);
}

.card-main {
  flex: 1;
  min-width: 0;
  padding-top: 8rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.meta {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.save {
  margin-top: 28rpx;
}

/* —— 导入完成：居中完整卡片 —— */
.result-card {
  padding: 72rpx 48rpx 56rpx;
  text-align: center;
}

.result-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.result-card .h1 {
  margin-bottom: 16rpx;
}

.result-line {
  font-size: 30rpx;
  margin: 8rpx 0;
}

.danger {
  color: var(--danger);
}

.result-actions {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.result-actions .btn-ghost,
.result-actions .btn-primary {
  margin: 0;
  width: 100%;
}
