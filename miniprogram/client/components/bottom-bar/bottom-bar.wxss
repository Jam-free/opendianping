.dock-safe {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 0 28rpx calc(16rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  box-sizing: border-box;
}

.dock {
  pointer-events: auto;
  display: flex;
  align-items: stretch;
  height: 112rpx;
  padding: 0 8rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 56rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    0 1rpx 0 rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  backdrop-filter: blur(20px);
}

.dock-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 48rpx;
}

.dock-item--press {
  background: rgba(0, 0, 0, 0.04);
}

.dock-icon {
  width: 44rpx;
  height: 44rpx;
}

.dock-icon--ai {
  width: 48rpx;
  height: 48rpx;
}

.dock-label {
  font-size: 20rpx;
  color: #333;
  line-height: 1.2;
  font-weight: 500;
}
