.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.editor {
  padding: 28rpx 28rpx 8rpx;
}

.thought {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  line-height: 1.55;
  box-sizing: border-box;
  padding: 0 0 16rpx;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 24rpx;
}

.photo-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.photo,
.add-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background: var(--bg);
}

.add-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #bbb;
}

.photo-x {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.place-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line);
}

.place-row--press {
  opacity: 0.7;
}

.place-ico {
  font-size: 28rpx;
  width: 40rpx;
  text-align: center;
}

.place-main {
  flex: 1;
  min-width: 0;
}

.place-label {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.place-value {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
}

.place-value.placeholder {
  font-weight: 400;
  color: var(--sub);
}

.place-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.35;
}

.chev {
  font-size: 36rpx;
  padding: 0 4rpx;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(245, 245, 245, 0.96);
  box-sizing: border-box;
}
