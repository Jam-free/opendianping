.page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.list {
  padding: 8rpx 28rpx;
}

.empty {
  padding: 64rpx 40rpx;
  text-align: center;
  min-height: 40vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
