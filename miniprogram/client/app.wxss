@import './styles/theme.wxss';

page {
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
  min-height: 100%;
  box-sizing: border-box;
}

.muted {
  color: var(--sub);
  font-size: 24rpx;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

/* 微信 button 自带 margin / 收缩宽度，不强制拉满就会靠左 */
.btn-primary,
.btn-ghost,
.btn-outline {
  border-radius: 16rpx;
  font-weight: 600;
  font-size: 30rpx;
  line-height: 1.4;
  padding: 0 32rpx;
  min-height: 88rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.btn-primary::after,
.btn-ghost::after,
.btn-outline::after {
  border: none;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border: none;
}

.btn-primary.button-hover {
  background: var(--primary-press);
}

.btn-ghost {
  background: #fff;
  color: var(--ink);
  border: 1rpx solid var(--line);
}

.btn-ghost.button-hover {
  background: #f7f7f7;
}

.btn-outline {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-block {
  width: 100% !important;
  display: flex;
  margin-left: 0 !important;
  margin-right: 0 !important;
}

.page-pad {
  padding: 24rpx 32rpx;
}

.hairline {
  border-bottom: 1rpx solid var(--line);
}
