<!--
  底栏必须放在 .page 外：page 若 overflow:hidden，微信里会把 position:fixed 裁掉，
  看起来就像「底部按钮没了」。
-->
<view class="page" style="padding-top: {{statusPad}}px;">
  <!--
    标题相对位置固定：左「私藏好店」右「吃货排行」；
    只切换字号/字色（当前大橙、另一页小灰），很常见的 UX。
  -->
  <view class="header">
    <view class="titles">
      <view class="title-hit" bindtap="goPanel" data-panel="0">
        <text class="title {{panel === 0 ? 'title--on' : 'title--off'}}">私藏好店</text>
      </view>
      <view class="title-hit title-hit--gap" bindtap="goPanel" data-panel="1">
        <text class="title {{panel === 1 ? 'title--on' : 'title--off'}}">吃货排行</text>
      </view>
    </view>
    <view class="avatar-entry" bindtap="goAccount" hover-class="avatar-hover">
      <image wx:if="{{avatar}}" class="me-av" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="me-av text">{{initial}}</view>
    </view>
  </view>
  <view class="header-line"></view>

  <swiper
    class="panels"
    current="{{panel}}"
    duration="300"
    easing-function="easeOutCubic"
    bindchange="onSwipe"
  >
    <swiper-item>
      <scroll-view scroll-y class="panel-scroll" enhanced show-scrollbar="{{false}}">
        <view class="sheet" wx:if="{{shops.length}}">
          <view class="list-tip">长按店铺可删除</view>
          <block wx:for="{{shops}}" wx:key="favoriteId">
            <view class="sheet-item">
              <shop-row
                shop="{{item}}"
                source-tag="{{item.sourceTag}}"
                bind:openshop="openShop"
                bind:deleteshop="onDeleteShop"
              />
            </view>
          </block>
        </view>

        <view class="empty" wx:elif="{{!shopsLoading}}">
          <view class="empty-title">还没有店铺</view>
          <view class="empty-desc">从大众点评导入公开专辑，或用底栏「记美食」记下此刻。</view>
          <button class="btn-primary btn-block empty-btn" bindtap="goImport">导入点评收藏</button>
          <button class="btn-ghost btn-block empty-btn-ghost" bindtap="goLocate">记一笔美食</button>
        </view>
        <view class="scroll-pad"></view>
      </scroll-view>
    </swiper-item>

    <swiper-item>
      <scroll-view scroll-y class="panel-scroll" enhanced show-scrollbar="{{false}}">
        <view class="rank-hint" wx:if="{{friends.length}}">按共享好店数排一排</view>

        <view class="sheet" wx:if="{{friends.length}}">
          <block wx:for="{{friends}}" wx:key="id">
            <view
              class="friend-row"
              hover-class="friend-row--press"
              bindtap="openFriend"
              data-id="{{item.id}}"
              data-name="{{item.nickname}}"
            >
              <view class="rank {{index < 3 ? 'rank--top' : ''}}">{{index + 1}}</view>
              <image wx:if="{{item.avatarSrc}}" class="fav" src="{{item.avatarSrc}}" mode="aspectFill" />
              <view wx:else class="fav text">{{item.initial}}</view>
              <view class="finfo">
                <view class="fname">{{item.nickname || '未命名好友'}}</view>
                <view class="fmeta">共享 {{item.sharedShopCount}} 家</view>
              </view>
              <text class="fchev">›</text>
            </view>
          </block>
        </view>

        <view class="login-tip" wx:elif="{{loginError}}" bindtap="retryLogin">
          <text class="login-tip-text">{{loginError}}</text>
          <text class="login-tip-link">重试</text>
        </view>

        <view class="empty" wx:elif="{{!friendsLoading}}">
          <view class="empty-title">还没有吃货上榜</view>
          <view class="empty-desc">邀请好友加入并共享收藏后，会出现在这里。</view>
          <button class="btn-primary btn-block empty-btn" open-type="share">邀请好友</button>
        </view>
        <view class="scroll-pad"></view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>

<!-- 悬浮底栏：与 page 同级，避免被裁切 / 被 swiper 盖住 -->
<view class="dock-safe">
  <view class="dock">
    <view class="dock-item" hover-class="dock-item--press" bindtap="goImport">
      <image class="dock-icon" src="/assets/icons/dock/import.png" mode="aspectFit" />
      <text class="dock-label">导入</text>
    </view>
    <view class="dock-item" hover-class="dock-item--press" bindtap="goConnectAi">
      <image class="dock-icon dock-icon--ai" src="/assets/icons/dock/connect-ai.png" mode="aspectFit" />
      <text class="dock-label">连接 AI</text>
    </view>
    <view class="dock-item" hover-class="dock-item--press" bindtap="goLocate">
      <image class="dock-icon" src="/assets/icons/dock/locate.png" mode="aspectFit" />
      <text class="dock-label">记美食</text>
    </view>
  </view>
</view>
