.pad {
  padding: 32rpx;
}

.hero-img {
  width: 100%;
  height: 300rpx;
  margin-bottom: 24rpx;
  background: var(--placeholder);
}

.hero-img.placeholder {
  border: 1rpx solid var(--line);
}

.big-dist {
  font-weight: 700;
  line-height: 1;
}

.big-dist .num {
  font-size: 120rpx;
}

.big-dist .unit {
  font-size: 48rpx;
}

.h1 {
  font-size: 56rpx;
  font-weight: 700;
  margin-top: 16rpx;
}

.meta {
  margin-top: 8rpx;
  font-size: 28rpx;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  gap: 24rpx;
}

.kv .v {
  text-align: right;
  flex: 1;
}

.sec {
  font-size: 24rpx;
  color: var(--sub);
  padding: 36rpx 32rpx 12rpx;
  letter-spacing: 2rpx;
}

.note {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
}

.av.lg {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--placeholder);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  flex: none;
}

.note-name {
  font-size: 28rpx;
  font-weight: 600;
}

.note-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.block {
  width: 100%;
}
