.page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 0 0 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.hero-img {
  width: 100%;
  height: 320rpx;
  background: var(--placeholder);
  display: block;
}

.hero-img.placeholder {
  border-bottom: 1rpx solid var(--line);
}

.title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 28rpx 28rpx 0;
}

.h1 {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
}

.dist {
  font-size: 24rpx;
}

.meta {
  padding: 8rpx 28rpx 0;
  font-size: 26rpx;
}

.block {
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}

.kv {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
}

.k {
  width: 80rpx;
  flex: none;
}

.v {
  flex: 1;
}

.sec {
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.note {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
}

.av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--placeholder);
  flex: none;
}

.av.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.note-name {
  font-size: 28rpx;
  font-weight: 600;
}

.note-text {
  margin-top: 4rpx;
  font-size: 24rpx;
}

.nav {
  margin-top: 8rpx;
}
