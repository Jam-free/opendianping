<view class="row" bindtap="onTap">
  <image
    wx:if="{{shop.headImgProxy}}"
    class="thumb"
    src="{{headImgProxyFull}}"
    mode="aspectFill"
  />
  <view wx:else class="thumb placeholder"></view>

  <view class="info">
    <view class="title-row">
      <view class="name">{{shop.name}}</view>
      <view class="dist" wx:if="{{!dist.na}}">{{dist.main}}{{dist.unit}}</view>
    </view>
    <view class="meta muted" wx:if="{{metaLine}}">{{metaLine}}</view>
    <view class="avs" wx:if="{{previewAvatars.length || shop.recommendersLine || sourceTag}}">
      <block wx:for="{{previewAvatars}}" wx:key="userId">
        <image wx:if="{{item.avatar}}" class="av" src="{{item.avatar}}" />
        <view wx:else class="av text">{{item.initial}}</view>
      </block>
      <text class="rec muted">{{sourceTag || shop.recommendersLine}}</text>
    </view>
  </view>
</view>
