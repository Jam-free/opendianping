.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 8rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* —— 大标题切换（非等宽 Tab） —— */
.title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 12rpx 4rpx 24rpx;
  flex: none;
  gap: 24rpx;
}

.title-main {
  flex: 1;
  min-width: 0;
}

.title-lg {
  font-size: 48rpx; /* ≈24px */
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.title-side-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: none;
}

.title-side {
  padding: 16rpx 8rpx;
  /* 扩大点小字热区，避免要精准点字才切换 */
}

.title-sm {
  font-size: 28rpx; /* ≈14px */
  font-weight: 500;
  color: var(--sub);
  line-height: 1.2;
}

.avatar-entry {
  padding: 2rpx;
}

.avatar-hover {
  opacity: 0.75;
}

.me-av {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--placeholder);
  border: 1rpx solid var(--line);
}

.me-av.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #555;
}

/* —— 可滑动双面板 —— */
.panels {
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
}

.panel-scroll {
  height: 100%;
  box-sizing: border-box;
}

/* 给悬浮底栏留空，避免最后一项被挡住 */
.scroll-pad {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.list {
  padding: 8rpx 28rpx;
}

.item:last-child .row {
  border-bottom: none;
}

.rank-intro {
  padding: 0 8rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.list-wrap {
  padding: 8rpx 28rpx;
  overflow: hidden;
}

.friend-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  gap: 16rpx;
}

.rank-badge {
  width: 40rpx;
  flex: none;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--sub);
}

.rank-badge.top {
  color: var(--primary);
  font-weight: 700;
}

.av {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--placeholder);
  flex: none;
}

.av.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  color: #555;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.meta {
  margin-top: 6rpx;
}

.chev {
  font-size: 36rpx;
}

.login-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  background: #fff8f0;
}

.link {
  color: var(--primary);
  font-weight: 600;
}

.empty-stage {
  min-height: 52vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
}

.empty-inner {
  width: 100%;
  max-width: 560rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  margin-bottom: 36rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-secondary {
  margin-top: 16rpx;
}
