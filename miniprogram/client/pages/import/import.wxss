.page {
  padding: 24rpx 24rpx calc(200rpx + env(safe-area-inset-bottom));
}

.panel {
  background: transparent;
}

.input {
  margin-top: 24rpx;
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 0;
  border: 1rpx solid var(--line);
}

.check-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0;
  color: var(--sub);
  font-size: 24rpx;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.toolbar-actions {
  display: flex;
  gap: 24rpx;
}

.link {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  text-decoration: underline;
}

.tip {
  margin-bottom: 16rpx;
}

.shop-card {
  background: var(--card);
  border-radius: 0;
  padding: 28rpx;
  margin-bottom: 0;
  border: 1rpx solid var(--line);
  border-bottom: none;
}

.shop-card:last-child {
  border-bottom: 1rpx solid var(--line);
}

.shop-card.checked {
  border-color: var(--line);
  background: var(--accent-soft);
}

.card-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.meta {
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.source-tag {
  font-size: 20rpx;
  color: var(--sub);
  background: transparent;
  padding: 4rpx 12rpx;
  border-radius: 0;
  border: 1rpx solid var(--line);
  white-space: nowrap;
}

.sub {
  margin-top: 12rpx;
  margin-left: 56rpx;
  color: var(--sub);
  font-size: 24rpx;
}

.addr {
  margin-top: 8rpx;
  margin-left: 56rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  display: flex;
  gap: 16rpx;
  align-items: center;
  border-top: 1rpx solid var(--line);
}

.vis {
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 0;
  border: 1rpx solid var(--line);
  color: var(--sub);
  font-size: 24rpx;
}

.save-btn {
  flex: 1;
}

.result-line {
  font-size: 36rpx;
  margin: 12rpx 0;
}

.result-line.ok {
  color: var(--success);
  font-weight: 700;
}

.result-line.danger {
  color: var(--danger);
}

.result button {
  margin-top: 20rpx;
}
