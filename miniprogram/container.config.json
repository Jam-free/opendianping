{
  "containerPort": 80,
  "dockerfilePath": "miniprogram/Dockerfile",
  "buildDir": "",
  "minNum": 0,
  "maxNum": 2,
  "cpu": 0.5,
  "mem": 1,
  "policyType": "cpu",
  "policyThreshold": 60,
  "envParams": {
    "PORT": "80",
    "DB_BACKEND": "mysql",
    "MYSQL_DATABASE": "feimaocat",
    "EXPECTED_MIN_USERS": "0",
    "PREVENT_EMPTY_DB_START": "true",
    "DEV_AUTH_BYPASS": "false",
    "SOURCE_ADAPTER": "opendianping"
  },
  "customLogs": "stdout",
  "initialDelaySeconds": 4
}
