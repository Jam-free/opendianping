.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.block {
  padding: 48rpx 36rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.block .btn-block {
  width: 100%;
}

.h1 {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.desc {
  margin: 28rpx 0 40rpx;
  line-height: 1.65;
  text-align: left;
}
