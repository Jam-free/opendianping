.page-stage {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 64rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.mark {
  width: 200rpx;
  height: 200rpx;
  border-radius: 44rpx;
  margin-bottom: 40rpx;
}

.brand {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink);
}

.pitch {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  max-width: 520rpx;
}

.guide {
  width: 100%;
  margin-bottom: 8rpx;
}

.guide-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--ink);
}

.guide-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.nick-step {
  width: 100%;
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-av {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.nick-input {
  width: 100%;
  margin-top: 36rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  height: 96rpx;
  min-height: 96rpx;
  line-height: 96rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  text-align: center;
  border: 1rpx solid #eee;
}

.login-btn {
  width: 100%;
  margin: 40rpx 0 0;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  background: #ff6b4a;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.login-btn::after {
  border: none;
}

.login-btn.button-hover {
  background: #e85a3c;
}

.nick-hint,
.busy-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
}

.repick {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--primary);
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  line-height: 1.55;
  font-size: 24rpx;
}

.err {
  margin-top: 20rpx;
  text-align: center;
  color: var(--danger);
  font-size: 26rpx;
  line-height: 1.45;
  padding: 0 8rpx;
}
