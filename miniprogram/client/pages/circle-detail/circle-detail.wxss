.page {
  padding: 24rpx 24rpx 80rpx;
}

.header {
  margin-bottom: 24rpx;
}

.filters {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.filter {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid var(--line);
  font-size: 24rpx;
}

.ops {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.mini {
  margin: 0 !important;
}

.empty {
  padding: 40rpx 8rpx;
  text-align: center;
}

.shop-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 106, 61, 0.06);
}

.name {
  font-size: 32rpx;
  font-weight: 700;
}

.meta {
  margin-top: 6rpx;
  color: var(--orange-deep);
  font-weight: 600;
}

.sub {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.addr {
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.collectors {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--orange-deep);
}
