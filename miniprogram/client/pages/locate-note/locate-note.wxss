.page {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.block {
  padding: 36rpx 28rpx;
}

.h1 {
  font-size: 36rpx;
  font-weight: 700;
}

.tip {
  margin: 8rpx 0 28rpx;
  line-height: 1.5;
}

.loc-card {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.loc-label {
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.addr-main {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.coords {
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  margin-bottom: 16rpx;
}

.mini {
  margin: 0;
  min-height: 56rpx !important;
  font-size: 24rpx !important;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: var(--sub);
  margin-bottom: 12rpx;
}

.input,
.textarea {
  width: 100%;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.textarea {
  min-height: 140rpx;
}

.photos {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.photo,
.add-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: var(--bg);
}

.add-photo {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #bbb;
  border: 1rpx dashed #ccc;
}

.remove {
  font-size: 24rpx;
}
