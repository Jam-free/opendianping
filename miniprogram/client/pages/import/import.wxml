<view class="page">
  <view class="panel" wx:if="{{step === 'input'}}">
    <view class="section-title">粘贴公开专辑链接</view>
    <view class="muted">含 albumid 的分享链接；也可粘贴多行店名（文本兜底）</view>
    <textarea
      class="input"
      placeholder="例如 https://h5.dianping.com/...album.html?albumid=12498807"
      value="{{text}}"
      bindinput="onText"
      maxlength="2000"
      auto-height
    />
    <label class="check-row">
      <switch checked="{{useFixtures}}" bindchange="onFixtures" color="#FF6A3D" />
      <text>离线样本（开发演示）</text>
    </label>
    <button class="btn-primary" loading="{{loading}}" bindtap="onParse">导入</button>
  </view>

  <view class="panel" wx:if="{{step === 'preview'}}">
    <view class="toolbar">
      <text class="section-title">预览 {{shops.length}} 家</text>
      <view class="toolbar-actions">
        <text class="link" bindtap="selectAll">全选</text>
        <text class="link" bindtap="selectNone">清空</text>
      </view>
    </view>
    <view class="muted tip" wx:if="{{message}}">{{message}}</view>

    <view
      class="shop-card {{item.checked ? 'checked' : ''}}"
      wx:for="{{shops}}"
      wx:key="index"
      data-index="{{index}}"
      bindtap="toggle"
    >
      <view class="card-top">
        <checkbox checked="{{item.checked}}" color="#FF6A3D" />
        <view class="card-main">
          <view class="name">{{item.name}}</view>
          <view class="meta" wx:if="{{item.avgPrice}}">{{item.avgPrice}}</view>
        </view>
        <view class="source-tag">{{item.sourceLabel}}</view>
      </view>
      <view class="sub" wx:if="{{item.category || item.district}}">
        <text wx:if="{{item.category}}">{{item.category}}</text>
        <text wx:if="{{item.category && item.district}}"> · </text>
        <text wx:if="{{item.district}}">{{item.district}}</text>
      </view>
      <view class="addr muted" wx:if="{{item.address}}">{{item.address}}</view>
    </view>

    <view class="save-bar">
      <picker range="{{visLabels}}" value="{{visIndex}}" bindchange="onVis">
        <view class="vis">共享：{{visLabels[visIndex]}}</view>
      </picker>
      <button class="btn-primary save-btn" loading="{{saving}}" bindtap="onSave">
        保存已选（{{selectedCount}}）
      </button>
    </view>
  </view>

  <view class="panel result" wx:if="{{step === 'result'}}">
    <view class="section-title">导入完成</view>
    <view class="result-line ok">成功 {{result.success}}</view>
    <view class="result-line">重复 {{result.duplicate}}</view>
    <view class="result-line danger" wx:if="{{result.failed}}">失败 {{result.failed}}</view>
    <button class="btn-primary" bindtap="goFavorites">查看收藏</button>
    <button class="btn-ghost" bindtap="undoBatch" wx:if="{{result.batchId}}">撤销本批</button>
    <button class="btn-ghost" bindtap="reset">再导一批</button>
  </view>
</view>
