/* 微信读书风：浅灰底、白卡片、蓝色主操作 */
page {
  --bg: #f5f5f5;
  --card: #ffffff;
  --ink: #111111;
  --sub: #8a8a8a;
  --line: #eeeeee;
  --primary: #3d7eff;
  --primary-press: #2f6ae6;
  --placeholder: #f0f0f0;
  --success: #1a7f4b;
  --danger: #e05a5a;
  --radius: 24rpx;
  --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}
