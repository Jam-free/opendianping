<view class="page page-stage">
  <view class="hero">
    <image class="mark" src="/assets/app-icon.jpg" mode="aspectFill" />
    <view class="brand">我和我爱吃的朋友们</view>
    <view class="pitch muted">
      把大众点评收藏搬进来，记美食、看自己的店，再和好友慢慢共享。
    </view>

    <!-- 登录前就把头像/昵称摆出来：微信要求用户主动点选，不能静默读取 -->
    <view class="profile" wx:if="{{!bypass}}">
      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseAvatar"
      >
        <image
          wx:if="{{draftAvatar}}"
          class="avatar"
          src="{{draftAvatar}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar placeholder">
          <text class="plus">+</text>
          <text class="avatar-hint">头像</text>
        </view>
      </button>
      <input
        class="nick-input"
        type="nickname"
        placeholder="点击填写微信昵称"
        value="{{draftNickname}}"
        bindinput="onNickInput"
        bindblur="onNickBlur"
      />
      <view class="profile-tip muted">朋友靠头像和昵称认出你，登录前先选一下</view>
    </view>

    <button class="login-btn" loading="{{busy}}" bindtap="onLogin">
      {{bypass ? '一键进入' : '微信登录'}}
    </button>
    <view class="hint muted" wx:if="{{bypass}}">
      开发模式：点上方即可进入，无需真实微信授权。
    </view>
    <view class="hint muted" wx:else>
      登录后才能导入收藏与使用「我的店」。我们不会自动读取你的微信好友。
    </view>
    <view class="err" wx:if="{{error}}">{{error}}</view>
  </view>
</view>
