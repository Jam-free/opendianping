/* 暖色主操作：跟登录页、头像同一套珊瑚红 */
page {
  --bg: #f5f5f5;
  --card: #ffffff;
  --ink: #111111;
  --sub: #8a8a8a;
  --line: #eeeeee;
  --primary: #ff6b4a;
  --primary-press: #e85a3c;
  --primary-soft: #fff0ec;
  --placeholder: #f0f0f0;
  --success: #1a7f4b;
  --danger: #e05a5a;
  --radius: 24rpx;
  --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}
