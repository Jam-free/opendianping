.page {
  padding: 24rpx 32rpx 48rpx;
}

.hero {
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
}

.brand {
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  margin-top: 8rpx;
  margin-bottom: 28rpx;
}

.invite {
  margin: 0;
}

.login-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  background: #fff8f0;
}

.link {
  color: var(--primary);
  font-weight: 600;
}

.list-wrap {
  padding: 8rpx 28rpx 8rpx;
  overflow: hidden;
}

.list-hd {
  padding: 20rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--sub);
}

.friend-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  gap: 20rpx;
}

.av {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--placeholder);
  flex: none;
}

.av.lg {
  width: 96rpx;
  height: 96rpx;
}

.av.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  color: #555;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.meta {
  margin-top: 6rpx;
}

.chev {
  font-size: 36rpx;
}

.empty {
  padding: 64rpx 40rpx;
  text-align: center;
  min-height: 42vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.empty .btn-block {
  width: 100%;
  max-width: 560rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  margin-bottom: 32rpx;
  line-height: 1.6;
  text-align: center;
}
