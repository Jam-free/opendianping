<view class="page">
  <view class="editor card">
    <textarea
      class="thought"
      placeholder="口味、推荐菜、避雷…"
      maxlength="500"
      value="{{note}}"
      bindinput="onNote"
      auto-height
      adjust-position="{{true}}"
      show-confirm-bar="{{false}}"
    />

    <view class="photos">
      <view wx:for="{{photos}}" wx:key="*this" class="photo-wrap">
        <image
          class="photo"
          src="{{item}}"
          mode="aspectFill"
          data-src="{{item}}"
          bindtap="previewPhoto"
        />
        <view class="photo-x" data-index="{{index}}" bindtap="removePhoto">×</view>
      </view>
      <view class="add-photo" bindtap="addPhoto" wx:if="{{photos.length < maxPhotos}}">+</view>
    </view>

    <view class="place-row" bindtap="goPickPlace" hover-class="place-row--press">
      <text class="place-ico">📍</text>
      <view class="place-main">
        <view class="place-label">美食地点</view>
        <view class="place-value {{placeName ? '' : 'placeholder'}}">
          {{placeName || '去选一下'}}
        </view>
        <view class="place-sub muted" wx:if="{{placeSub}}">{{placeSub}}</view>
      </view>
      <text class="chev muted">›</text>
    </view>
  </view>

  <view class="dock">
    <button
      class="btn-primary btn-block"
      loading="{{saving}}"
      bindtap="onSave"
    >
      {{editing ? '保存修改' : '记下'}}
    </button>
  </view>
</view>
