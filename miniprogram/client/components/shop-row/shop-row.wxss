.row {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 0;
  gap: 24rpx;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  flex: none;
  background: var(--placeholder);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.info {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dist {
  flex: none;
  font-size: 24rpx;
  color: var(--sub);
  font-weight: 500;
}

.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avs {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  gap: 8rpx;
}

.av {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--placeholder);
  flex: none;
}

.av.text {
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #555;
  font-weight: 600;
}

.rec {
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
