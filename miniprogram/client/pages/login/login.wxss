.page-stage {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 64rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.mark {
  width: 200rpx;
  height: 200rpx;
  border-radius: 44rpx;
  margin-bottom: 40rpx;
}

.brand {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink);
}

.pitch {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  max-width: 520rpx;
}

.profile {
  width: 100%;
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 160rpx;
  height: 160rpx;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
  background: #f0f0f0;
}

.avatar.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccc;
  box-sizing: border-box;
  color: #999;
}

.plus {
  font-size: 48rpx;
  line-height: 1;
}

.avatar-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.nick-input {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  text-align: center;
  border: 1rpx solid #eee;
}

.profile-tip {
  font-size: 22rpx;
  line-height: 1.4;
}

/* 微信按钮默认会缩成内容宽度并靠左，这里拉满并跟头像用同一种珊瑚红 */
.login-btn {
  width: 100%;
  margin: 40rpx 0 0;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  background: #ff6b4a;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.login-btn::after {
  border: none;
}

.login-btn.button-hover {
  background: #e85a3c;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  line-height: 1.55;
  font-size: 24rpx;
}

.err {
  margin-top: 20rpx;
  text-align: center;
  color: var(--danger);
  font-size: 26rpx;
}
