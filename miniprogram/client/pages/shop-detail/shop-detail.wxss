.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg, #f5f5f5);
}

.scroll {
  flex: 1;
  height: 0;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.scroll-pad {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 0 0 28rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.hero-img {
  width: 100%;
  height: 320rpx;
  background: var(--placeholder);
  display: block;
  border-bottom: 1rpx solid var(--line);
}

.hero-body {
  padding: 28rpx 28rpx 0;
}

.h1 {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.meta {
  margin-top: 8rpx;
  font-size: 26rpx;
}

.dist {
  margin-top: 10rpx;
  font-size: 24rpx;
}

/* 操作条：等分图标，整齐一排 */
.action-bar {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  padding: 20rpx 8rpx;
  margin-bottom: 20rpx;
}

.action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 12rpx 0;
  min-width: 0;
}

.action-hover {
  opacity: 0.72;
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: block;
}

.action-label.danger {
  color: var(--danger);
}

.action-label {
  font-size: 22rpx;
  color: var(--sub, #666);
  line-height: 1.2;
  text-align: center;
}

.block {
  padding: 8rpx 28rpx;
  margin-bottom: 20rpx;
}

.kv {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  align-items: flex-start;
}

.k {
  width: 80rpx;
  flex: none;
}

.v {
  flex: 1;
}

.sec {
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.comments .tip {
  margin: 0 0 16rpx;
  line-height: 1.5;
  font-size: 24rpx;
}

.note {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
}

.av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--placeholder);
  flex: none;
}

.av.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.note-name {
  font-size: 28rpx;
  font-weight: 600;
}

.me {
  margin-left: 10rpx;
  font-size: 22rpx;
  font-weight: 400;
}

.note-text {
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text, #222);
}

.note-time {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line, #eee);
  box-sizing: border-box;
  z-index: 20;
}

.dock-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg, #f5f5f5);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.dock-send {
  margin: 0;
  background: var(--brand, #ff6b4a) !important;
  color: #fff !important;
  border-radius: 32rpx !important;
  font-size: 26rpx !important;
  padding: 0 24rpx !important;
  line-height: 64rpx !important;
  min-height: 64rpx !important;
}

.heart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  padding: 4rpx 8rpx;
  color: #999;
}

.heart.on {
  color: var(--brand, #ff6b4a);
}

.heart-icon {
  font-size: 36rpx;
  line-height: 1.1;
}

.heart-label {
  font-size: 18rpx;
  margin-top: 2rpx;
}

.heart-hover {
  opacity: 0.75;
}
