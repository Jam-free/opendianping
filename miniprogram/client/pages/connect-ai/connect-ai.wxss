.page {
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.intro {
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
}

.intro-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.intro-desc {
  line-height: 1.6;
  font-size: 26rpx;
}

.section-label {
  font-size: 26rpx;
  color: var(--sub);
  margin: 8rpx 0 16rpx;
  font-weight: 600;
}

/* 真机上 flex + gap + calc(50%) 经常错位，改成单列列表更稳 */
.cap-list {
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.cap-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 0;
}

.cap-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-top: 12rpx;
  flex: none;
}

.cap-body {
  flex: 1;
  min-width: 0;
}

.cap-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.cap-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
}

.block {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.step {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.tip {
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.code {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 22rpx;
  font-family: Menlo, monospace;
  word-break: break-all;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
  margin-bottom: 20rpx;
  color: #333;
  line-height: 1.55;
  max-height: 420rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.token-box {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.token {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-family: Menlo, monospace;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.eye {
  color: var(--primary);
  font-size: 24rpx;
  flex: none;
  padding-top: 4rpx;
}

.token-actions {
  display: flex;
  gap: 16rpx;
}

.half {
  flex: 1;
  width: auto !important;
  margin: 0 !important;
  min-width: 0;
  padding: 0 16rpx !important;
  font-size: 26rpx !important;
}

.dates {
  margin-top: 16rpx;
  font-size: 22rpx;
}

.foot {
  padding: 8rpx 4rpx 16rpx;
  line-height: 1.6;
  font-size: 22rpx;
}
