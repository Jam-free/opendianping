.page-stage {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 64rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.mark {
  width: 200rpx;
  height: 200rpx;
  border-radius: 44rpx;
  margin-bottom: 40rpx;
}

.brand {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink);
}

.pitch {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  max-width: 520rpx;
}

/* 微信按钮默认会缩成内容宽度并靠左，这里拉满并跟头像用同一种珊瑚红 */
.login-btn {
  width: 100%;
  margin: 56rpx 0 0;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  background: #ff6b4a;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.login-btn::after {
  border: none;
}

.login-btn.button-hover {
  background: #e85a3c;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  line-height: 1.55;
  font-size: 24rpx;
}

.err {
  margin-top: 20rpx;
  text-align: center;
  color: var(--danger);
  font-size: 26rpx;
}
