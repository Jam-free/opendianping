# 服务（云托管通常 PORT=80，DB_PATH=/data/miniprogram.db）
PORT=8787
# 数据源适配器：opendianping（方案 A，读公开专辑）| text_amap（方案 B，文本+高德兜底）
SOURCE_ADAPTER=opendianping
# 导入限流：每用户每分钟次数
IMPORT_RATE_LIMIT_PER_MIN=5
# 专辑最大店铺数（超出截断）
IMPORT_MAX_SHOPS=200
# Agent 写入「我的店」限流（每 Token/用户）
AGENT_SHOP_WRITE_PER_MIN=30
AGENT_SHOP_WRITE_PER_DAY=200

# 微信小程序（AppID 开发阶段可用 touristappid）
# 正式登录：小程序 callContainer 会注入 x-wx-openid / x-wx-from-openid，不必出网。
# 无这些头（公网 curl）才用 code + WECHAT_APP_SECRET 调 jscode2session。
WECHAT_APPID=touristappid
WECHAT_APP_SECRET=

# 开发态：跳过真实 code2session，用固定 openid（勿用于生产；云托管必须 false）
DEV_AUTH_BYPASS=true
DEV_OPENID_PREFIX=dev_

# 高德 Web 服务 Key（方案 B 匹配 POI；不填则只返回店名，不编造 poi_id）
AMAP_KEY=

# SQLite 路径（相对 miniprogram/ 或绝对路径）
# 本地默认 SQLite，首次创建空库是正常的。
DB_PATH=./data/miniprogram.db

# 生产请用云托管 MySQL（容器盘上的 SQLite 会随重启丢失）。
# 二选一：DATABASE_URL 或 MYSQL_* 。真实密码只放控制台，不要提交。
# DB_BACKEND=mysql
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/feimaocat
# MYSQL_ADDRESS=127.0.0.1:3306
# MYSQL_USERNAME=<YOUR_MYSQL_USERNAME>
# MYSQL_PASSWORD=<YOUR_MYSQL_PASSWORD>
# MYSQL_DATABASE=feimaocat
# EXPECTED_MIN_USERS=0
# PREVENT_EMPTY_DB_START=true

# COS JSON 备份（可选，MySQL 之外的快照）
# TENCENTCLOUD_SECRETID=
# TENCENTCLOUD_SECRETKEY=
# BACKUP_BUCKET=
# BACKUP_REGION=ap-guangzhou
# BACKUP_PREFIX=backups
