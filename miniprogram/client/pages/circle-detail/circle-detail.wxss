.page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.header {
  margin-bottom: 24rpx;
}

.filters {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  align-items: center;
}

.filter {
  flex: 1;
  background: #fff;
  border-radius: 0;
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--line);
  font-size: 24rpx;
}

.ops {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.mini {
  margin: 0 !important;
}

.empty {
  padding: 40rpx 8rpx;
  text-align: center;
}

.shop-card {
  background: var(--card);
  border-radius: 0;
  padding: 28rpx;
  margin-bottom: 0;
  border: 1rpx solid var(--line);
  border-bottom: none;
}

.shop-card:last-child {
  border-bottom: 1rpx solid var(--line);
}

.name {
  font-size: 32rpx;
  font-weight: 700;
}

.meta {
  margin-top: 6rpx;
  color: var(--ink);
  font-weight: 600;
}

.sub {
  margin-top: 12rpx;
  color: var(--sub);
  font-size: 24rpx;
}

.addr {
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.collectors {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--sub);
}
