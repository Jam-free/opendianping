.dock-safe {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 0 40rpx calc(20rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  box-sizing: border-box;
}

.dock {
  pointer-events: auto;
  display: flex;
  align-items: stretch;
  height: 120rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow:
    0 10rpx 40rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.dock-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 999rpx;
}

.dock-item--press {
  background: rgba(255, 107, 74, 0.06);
}

.dock-icon {
  width: 44rpx;
  height: 44rpx;
}

.dock-icon--ai {
  width: 48rpx;
  height: 48rpx;
}

.dock-label {
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--primary);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
