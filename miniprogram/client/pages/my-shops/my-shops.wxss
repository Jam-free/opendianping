/* 主页：白底干净版式；顶栏大标题切换 + 悬浮胶囊底栏 */

.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
}

/* —— 顶栏：左对齐大/小标题并排，头像靠右 —— */
.header {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 40rpx 20rpx;
  gap: 24rpx;
}

.titles {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  min-width: 0;
  flex: 1;
}

.title-hit {
  padding: 10rpx 4rpx;
  flex: none;
}

.title-hit--off {
  /* 小字热区略放大，好点 */
  padding: 18rpx 12rpx 10rpx;
  margin-left: -8rpx;
}

.title {
  line-height: 1.15;
  letter-spacing: 0.5rpx;
}

/* 当前页：约 22–24px 橙色加粗 */
.title--on {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--primary);
}

/* 另一页：约 14–15px 灰色常规字重，紧挨在右侧 */
.title--off {
  font-size: 28rpx;
  font-weight: 400;
  color: #b0b0b0;
}

.avatar-entry {
  flex: none;
  margin-right: 8rpx;
}

.avatar-hover {
  opacity: 0.72;
}

.me-av {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--placeholder);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.me-av.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #666;
}

.header-line {
  flex: none;
  height: 1rpx;
  margin: 0 40rpx;
  background: #f0f0f0;
}

/* —— 内容区 —— */
.panels {
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
}

.panel-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 0 40rpx;
}

.scroll-pad {
  height: calc(200rpx + env(safe-area-inset-bottom));
}

.sheet {
  padding-top: 8rpx;
}

.sheet-item {
  border-bottom: 1rpx solid #f3f3f3;
}

.sheet-item:last-child {
  border-bottom: none;
}

.rank-hint {
  padding: 24rpx 0 8rpx;
  font-size: 24rpx;
  color: #b0b0b0;
  letter-spacing: 0.5rpx;
}

.friend-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  gap: 18rpx;
  border-bottom: 1rpx solid #f3f3f3;
}

.friend-row:last-child {
  border-bottom: none;
}

.friend-row--press {
  opacity: 0.7;
}

.rank {
  width: 40rpx;
  flex: none;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #c4c4c4;
  font-variant-numeric: tabular-nums;
}

.rank--top {
  color: var(--primary);
  font-weight: 700;
}

.fav {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--placeholder);
  flex: none;
}

.fav.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 28rpx;
  color: #666;
}

.finfo {
  flex: 1;
  min-width: 0;
}

.fname {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fmeta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

.fchev {
  font-size: 34rpx;
  color: #d0d0d0;
  flex: none;
  padding-left: 8rpx;
}

.login-tip {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: #fff7f3;
  border: 1rpx solid #ffe4d9;
}

.login-tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.45;
}

.login-tip-link {
  flex: none;
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
}

.empty {
  min-height: 58vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx 80rpx;
  text-align: center;
  box-sizing: border-box;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9a9a9a;
  line-height: 1.65;
  max-width: 480rpx;
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 100% !important;
  max-width: 520rpx;
}

.empty-btn-ghost {
  width: 100% !important;
  max-width: 520rpx;
  margin-top: 20rpx;
}
