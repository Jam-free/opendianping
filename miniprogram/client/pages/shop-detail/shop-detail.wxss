.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg, #f5f5f5);
}

.scroll {
  flex: 1;
  height: 0;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

.scroll-pad {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 0 0 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.hero-img {
  width: 100%;
  height: 320rpx;
  background: var(--placeholder);
  display: block;
  border-bottom: 1rpx solid var(--line);
}

.title-row {
  padding: 28rpx 28rpx 0;
}

.h1 {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.dist-block {
  padding: 12rpx 28rpx 0;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}

.dist {
  font-size: 24rpx;
}

.nav-link {
  font-size: 24rpx;
  color: var(--brand, #ff6b4a);
  font-weight: 600;
}

.meta {
  padding: 8rpx 28rpx 0;
  font-size: 26rpx;
}

.block {
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}

.kv {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  align-items: flex-start;
}

.k {
  width: 80rpx;
  flex: none;
}

.v {
  flex: 1;
}

.phone {
  color: var(--brand, #ff6b4a);
}

.source-row {
  align-items: center;
}

.source-right {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dp-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #ff6633;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dp-icon-hover {
  opacity: 0.85;
}

.sec {
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.comments .tip {
  margin: 0 0 16rpx;
  line-height: 1.5;
  font-size: 24rpx;
}

.note {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
}

.av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--placeholder);
  flex: none;
}

.av.text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.note-name {
  font-size: 28rpx;
  font-weight: 600;
}

.me {
  margin-left: 10rpx;
  font-size: 22rpx;
  font-weight: 400;
}

.note-text {
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text, #222);
}

.note-time {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line, #eee);
  box-sizing: border-box;
}

.dock-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg, #f5f5f5);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.dock-send {
  margin: 0;
  background: var(--brand, #ff6b4a) !important;
  color: #fff !important;
  border-radius: 32rpx !important;
  font-size: 26rpx !important;
  padding: 0 24rpx !important;
  line-height: 64rpx !important;
  min-height: 64rpx !important;
}

.heart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  padding: 4rpx 8rpx;
  color: #999;
}

.heart.on {
  color: var(--brand, #ff6b4a);
}

.heart-icon {
  font-size: 36rpx;
  line-height: 1.1;
}

.heart-label {
  font-size: 18rpx;
  margin-top: 2rpx;
}

.heart-hover {
  opacity: 0.75;
}

.edit-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #fff;
  border: 1rpx solid var(--line, #eee);
  border-radius: 32rpx;
  padding: 12rpx 22rpx;
  font-size: 22rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
