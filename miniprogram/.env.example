# 服务（云托管通常 PORT=80，DB_PATH=/data/miniprogram.db）
PORT=8787
# 数据源适配器：opendianping（方案 A，读公开专辑）| text_amap（方案 B，文本+高德兜底）
SOURCE_ADAPTER=opendianping
# 导入限流：每用户每分钟次数
IMPORT_RATE_LIMIT_PER_MIN=5
# 专辑最大店铺数（超出截断）
IMPORT_MAX_SHOPS=200

# 微信小程序（AppID 开发阶段可用 touristappid）
WECHAT_APPID=touristappid
WECHAT_APP_SECRET=

# 开发态：跳过真实 code2session，用固定 openid（勿用于生产）
DEV_AUTH_BYPASS=true
DEV_OPENID_PREFIX=dev_

# 高德 Web 服务 Key（方案 B 匹配 POI；不填则只返回店名，不编造 poi_id）
AMAP_KEY=

# SQLite 路径（相对 miniprogram/ 或绝对路径）
DB_PATH=./data/miniprogram.db
