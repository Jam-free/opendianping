.page {
  padding: 24rpx;
}

.create {
  margin-bottom: 32rpx;
}

.empty {
  padding: 48rpx 16rpx;
  text-align: center;
}

.circle-card {
  background: var(--card);
  border-radius: 0;
  padding: 28rpx;
  margin-bottom: 0;
  border: 1rpx solid var(--line);
  border-bottom: none;
}

.circle-card:last-child {
  border-bottom: 1rpx solid var(--line);
}

.name {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
