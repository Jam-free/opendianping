{
  "name": "opendianping-miniprogram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "微信小程序：导入点评公开专辑 + 共享收藏圈",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build:mp": "tsc -p client/tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/supertest": "^6.0.2",
    "jest": "^30.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
