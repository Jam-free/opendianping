.dock-safe {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 0 40rpx calc(20rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  box-sizing: border-box;
}

.dock {
  pointer-events: auto;
  display: flex;
  align-items: stretch;
  height: 168rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow:
    0 10rpx 40rpx rgba(0, 0, 0, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.dock-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 999rpx;
}

.dock-item--press {
  background: transparent;
}

.dock-item--press .dock-fab {
  opacity: 0.82;
  transform: scale(0.96);
}

/* 与主页底栏同一套：白线图标 + 品牌渐变圆角方块 */
.dock-fab {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ff9a3d 0%, #ff5e3a 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.dock-icon {
  width: 48rpx;
  height: 48rpx;
}

.dock-label {
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--primary);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
