.bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  width: auto;
  height: 112rpx;
  border-radius: 4rpx;
  background: var(--gradient);
  display: flex;
  align-items: stretch;
  border: 1rpx solid var(--line);
  z-index: 99;
}

.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  gap: 4rpx;
}

.icon {
  font-size: 36rpx;
  line-height: 1;
}

.divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.4);
  margin: 24rpx 0;
}
